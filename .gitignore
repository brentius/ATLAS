# Local agent instructions, plans and project-state documents.
/BOTS/

# Track PCB sources and parts libraries; ignore temporary files.
/pcb/**
!/pcb/**/
!/pcb/**/*.kicad_pro
!/pcb/**/*.kicad_sch
!/pcb/**/*.kicad_pcb
!/pcb/**/*.kicad_sym
!/pcb/**/*.pretty/*.kicad_mod
!/pcb/**/fp-lib-table
!/pcb/**/sym-lib-table

# Keep saved history, autosaves and review snapshots ignored even when they contain KiCad sources.
/pcb/**/.history/
/pcb/**/*-backups/
/pcb/**/_autosave-*
/pcb/**/~*
/pcb/**/routing_review/

# TI's downloaded OPAx828 model is kept locally for simulation, not vendored.
/sim/atlas_tia/vendor/
/sim/atlas_tia/*.log
/sim/atlas_tia/*.raw
/sim/atlas_tia/*.db
/sim/atlas_tia/__pycache__/
/sim/atlas_tia/generated/
/sim/atlas_psu/__pycache__/
